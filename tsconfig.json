{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "types": ["bun"],

    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
